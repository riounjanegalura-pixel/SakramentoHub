APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

# Where password-reset (parishioner and admin/staff) and email-verification
# (parishioner only) links point a notified user at — this API has no
# server-rendered pages of its own. Defaults fall back to FRONTEND_URL /
# the admin dev port if unset; see config/app.php.
PARISHIONER_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174

# --- GCash payments via PayMongo (the client's "MongoPay") -----------------
# PLACEHOLDERS — real credentials must come from the parish's own PayMongo
# account (dashboard.paymongo.com > Developers). Until they're set, starting a
# payment returns 503 and the webhook rejects everything: no money can move.
# Use the sk_test_ key + PAYMONGO_MODE=test for sandbox, sk_live_ + live for
# production — PayMongo uses the same API host for both. See config/paymongo.php.
PAYMONGO_MODE=test
# NEEDS REAL VALUE, e.g. sk_test_xxxxxxxxxxxx (left blank = payments disabled).
PAYMONGO_SECRET_KEY=
# NEEDS REAL VALUE, e.g. whsk_xxxxxxxxxxxx — the `secret_key` PayMongo returns
# when you register the webhook (POST /v1/webhooks, url =
# <APP_URL>/api/webhooks/paymongo, events = ["checkout_session.payment.paid"]).
# Used to verify the Paymongo-Signature header (left blank = webhook rejects all).
PAYMONGO_WEBHOOK_SECRET=

# The first admin account, created once on the server (password at least 8 characters). Required in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
PAYMONGO_BASE_URL=https://api.paymongo.com/v1
# Seconds of clock skew allowed on a webhook's signed timestamp (replay guard).
PAYMONGO_WEBHOOK_TOLERANCE=300
# false: payment marks the booking paid, staff still approve it after review.
# true: a confirmed payment approves the booking automatically.
PAYMONGO_AUTO_APPROVE_ON_PAYMENT=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite everywhere (local dev and production, see docs/DEPLOYMENT.md) — fine
# at this project's scale, and one less service to stand up. Just needs the
# file to exist: `touch database/database.sqlite`.
DB_CONNECTION=sqlite

# Minutes until a Sanctum bearer token expires. Default (30 days) is set in
# config/sanctum.php — override here only if a different lifetime is needed.
# SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log keeps mail in the log. For real delivery: MAIL_MAILER=brevo with BREVO_API_KEY and a verified sender.
MAIL_MAILER=log
# BREVO_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
